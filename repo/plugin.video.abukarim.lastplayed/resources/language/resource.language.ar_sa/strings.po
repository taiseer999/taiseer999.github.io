msgstr "شغّل الرابط المحفوظ"

msgctxt "#30084"
msgid "Play from sources - %s"
msgstr "شغّل من المصادر - %s"

msgctxt "#30085"
msgid "Saved link expired - playing from sources"
msgstr "الرابط المحفوظ منتهي - جاري التشغيل من المصادر"

msgctxt "#30086"
