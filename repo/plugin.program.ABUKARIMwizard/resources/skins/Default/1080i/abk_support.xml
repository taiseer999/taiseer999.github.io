<?xml version="1.0" encoding="UTF-8"?>
<!-- "Support ABUKARIM" dialog: Buy Me a Coffee QR. Python contract:
     Window.Property(title|text|url|hint|qr|logo). Any key closes it. -->
<window type="dialog">
    <defaultcontrol always="true">9100</defaultcontrol>
    <zorder>2</zorder>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="F5000000">white.png</texture>
        </control>

        <control type="label">
            <left>0</left><top>80</top><width>1920</width><height>90</height>
            <font>AbkTitle</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>
        <control type="image">
            <left>885</left><top>180</top><width>150</width><height>5</height>
            <texture colordiffuse="FF8B5CF6">white.png</texture>
        </control>

        <!-- QR on a white card -->
        <control type="image">
            <left>234</left><top>244</top><width>632</width><height>632</height>
            <texture colordiffuse="668B5CF6">white.png</texture>
        </control>
        <control type="image">
            <left>240</left><top>250</top><width>620</width><height>620</height>
            <texture colordiffuse="FFFFFFFF">white.png</texture>
        </control>
        <control type="image">
            <left>250</left><top>260</top><width>600</width><height>600</height>
            <texture>$INFO[Window.Property(qr)]</texture>
            <aspectratio>keep</aspectratio>
        </control>

        <!-- right panel -->
        <control type="image">
            <left>919</left><top>249</top><width>762</width><height>622</height>
            <texture colordiffuse="2EFFFFFF">white.png</texture>
        </control>
        <control type="image">
            <left>920</left><top>250</top><width>760</width><height>620</height>
            <texture colordiffuse="FF101010">white.png</texture>
        </control>
        <control type="image">
            <left>920</left><top>250</top><width>760</width><height>620</height>
            <texture colordiffuse="14FFFFFF">white.png</texture>
        </control>
        <control type="image">
            <left>1200</left><top>290</top><width>200</width><height>200</height>
            <texture>$INFO[Window.Property(logo)]</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="textbox">
            <left>970</left><top>520</top><width>660</width><height>230</height>
            <font>AbkRow</font>
            <align>center</align>
            <textcolor>FFDCE2E7</textcolor>
            <label>$INFO[Window.Property(text)]</label>
        </control>
        <control type="label">
            <left>920</left><top>770</top><width>760</width><height>60</height>
            <font>AbkRowBold</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FF8B5CF6</textcolor>
            <label>$INFO[Window.Property(url)]</label>
        </control>

        <control type="label">
            <left>0</left><top>930</top><width>1920</width><height>60</height>
            <font>AbkHint</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FF8F9BA6</textcolor>
            <label>$INFO[Window.Property(hint)]</label>
        </control>

        <control type="button" id="9100">
            <left>-10</left><top>-10</top><width>1</width><height>1</height>
            <texturefocus />
            <texturenofocus />
            <label></label>
        </control>
    </controls>
</window>
