msgid "Install a Build"
msgstr "تثبيت بيلد"

msgctxt "#30002"
msgid "Maintenance Tools"
msgstr "أدوات الصيانة"

msgctxt "#30003"
msgid ""
"Clear all the data in your current setup. This action cannot be undone."
msgstr ""
"سيتم مسح جميع البيانات في إعدادك الحالي. لا يمكن التراجع عن هذا الإجراء."

msgctxt "#30004"
msgid "Install Build"
msgstr "تثبيت البيلد"

msgctxt "#30005"
msgid "Clear the packages folder to free up space."
msgstr "امسح مجلد الحزم لتوفير مساحة."

msgctxt "#30006"
msgid "Fresh Start"
msgstr "بداية جديدة"

msgctxt "#30007"
msgid "Clear all data. Warning, this cannot be undone."
msgstr "مسح جميع البيانات. تحذير، لا يمكن التراجع عن هذا."

msgctxt "#30008"
msgid ""
"Delete the Thumbnails folder and Textures13 database file. You should only "
