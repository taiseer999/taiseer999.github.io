<?xml version="1.0" encoding="UTF-8"?>
<!-- AB Tools 4.8.2: resume screen for Search All picks (Fen Light+ style).
     Filled by resources/lib/resume_screen.py through window properties abk.r.* -->
<window type="dialog">
    <defaultcontrol always="true">10</defaultcontrol>
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>
    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <!-- backdrop -->
        <control type="image">
            <texture>special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/white.png</texture>
            <colordiffuse>FF000000</colordiffuse>
        </control>
        <control type="image">
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Window.Property(abk.r.fanart)]</texture>
            <colordiffuse>FF4A4A4A</colordiffuse>
        </control>
        <control type="image">
            <width>1300</width>
            <texture>special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/grad_left.png</texture>
            <colordiffuse>D9000000</colordiffuse>
        </control>

        <!-- logo, or the title when there is none -->
        <control type="image">
            <left>90</left>
            <top>110</top>
            <width>760</width>
            <height>190</height>
            <aspectratio align="left" aligny="bottom">keep</aspectratio>
            <texture background="true">$INFO[Window.Property(abk.r.logo)]</texture>
            <visible>!String.IsEmpty(Window.Property(abk.r.logo))</visible>
        </control>
        <control type="textbox">
            <left>90</left>
            <top>110</top>
            <width>1100</width>
            <height>190</height>
            <font>abk_srch_l</font>
            <textcolor>FFFFFFFF</textcolor>
            <aligny>bottom</aligny>
            <label>[B]$INFO[Window.Property(abk.r.title)][/B]</label>
            <visible>String.IsEmpty(Window.Property(abk.r.logo))</visible>
        </control>

        <!-- year | running time | ends at -->
        <control type="label">
            <left>90</left>
            <top>312</top>
            <width>1400</width>
            <height>48</height>
            <font>abk_srch_l</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(abk.r.line1)]</label>
        </control>
        <!-- certificate | genres | rating -->
        <control type="label">
            <left>90</left>
            <top>366</top>
            <width>1400</width>
            <height>40</height>
            <font>abk_srch_m</font>
            <textcolor>FFC4CBD3</textcolor>
            <label>$INFO[Window.Property(abk.r.line2)]</label>
        </control>
        <!-- plot -->
        <control type="textbox">
            <left>90</left>
            <top>428</top>
            <width>1060</width>
            <height>140</height>
            <font>abk_srch_m</font>
            <textcolor>FFE6E9ED</textcolor>
            <label>$INFO[Window.Property(abk.r.plot)]</label>
            <autoscroll delay="6000" time="2500" repeat="8000">true</autoscroll>
        </control>

        <!-- buttons -->
        <control type="grouplist" id="100">
            <left>90</left>
            <top>976</top>
            <width>1400</width>
            <height>60</height>
            <orientation>horizontal</orientation>
            <itemgap>14</itemgap>
            <onup>noop</onup>
            <ondown>noop</ondown>
            <control type="button" id="10">
                <width>214</width>
                <height>60</height>
                <font>abk_srch_m</font>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(abk.r.resume)]</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF14181D</focusedcolor>
                <texturefocus border="26" colordiffuse="FFE9ECEF">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturefocus>
                <texturenofocus border="26" colordiffuse="66545C66">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturenofocus>
                <visible>!String.IsEmpty(Window.Property(abk.r.resume))</visible>
            </control>
            <control type="button" id="11">
                <width>214</width>
                <height>60</height>
                <font>abk_srch_m</font>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(abk.r.start)]</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF14181D</focusedcolor>
                <texturefocus border="26" colordiffuse="FFE9ECEF">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturefocus>
                <texturenofocus border="26" colordiffuse="66545C66">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturenofocus>
            </control>
            <control type="button" id="12">
                <width>214</width>
                <height>60</height>
                <font>abk_srch_m</font>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(abk.r.cancel)]</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF14181D</focusedcolor>
                <texturefocus border="26" colordiffuse="FFE9ECEF">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturefocus>
                <texturenofocus border="26" colordiffuse="66545C66">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/pill60.png</texturenofocus>
            </control>
        </control>

        <!-- watched so far -->
        <control type="progress" id="30">
            <left>90</left>
            <top>1050</top>
            <width>1740</width>
            <height>6</height>
            <texturebg colordiffuse="55FFFFFF">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/white.png</texturebg>
            <midtexture colordiffuse="FFFFFFFF">special://home/addons/plugin.program.abukarimtools/resources/lucent/media/lucent/white.png</midtexture>
            <lefttexture />
            <righttexture />
            <overlaytexture />
            <visible>!String.IsEmpty(Window.Property(abk.r.resume))</visible>
        </control>
    </controls>
</window>
