<?xml version="1.0" encoding="UTF-8"?>
<!-- ABUKARIM TOOLS 4.9.3 - picture picker as a grid of cards (grid_ui.py;
     first the "AF3: OSD Flags Style" picker of 4.9.1). ListItem: Label = name,
     Label2 = description (shown under the title), Art(thumb) = picture,
     Property(current) = true on the choice in use, Property(fit) = keep for a
     picture shown whole on a dark tile (icons, skin art) instead of filling. -->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <animation type="WindowOpen" reversible="false"><effect type="fade" start="0" end="100" time="200"/></animation>
    <animation type="WindowClose" reversible="false"><effect type="fade" start="100" end="0" time="160"/></animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="F205060A">white.png</texture>
        </control>
        <control type="label">
            <left>120</left><top>44</top><width>1680</width><height>64</height>
            <font>abk_set_xl</font><align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>
        <control type="label">
            <left>120</left><top>110</top><width>1680</width><height>44</height>
            <font>abk_set_s</font><align>center</align><aligny>center</aligny>
            <textcolor>B3FFFFFF</textcolor>
            <label>$INFO[Container(100).ListItem.Label2]</label>
        </control>
        <control type="label">
            <left>1520</left><top>44</top><width>280</width><height>64</height>
            <font>abk_set_s</font><align>right</align><aligny>center</aligny>
            <textcolor>66FFFFFF</textcolor>
            <label>$INFO[Container(100).CurrentItem] / $INFO[Container(100).NumItems]</label>
        </control>
        <control type="panel" id="100">
            <left>120</left><top>176</top><width>1680</width><height>880</height>
            <orientation>vertical</orientation>
            <scrolltime tween="cubic" easing="out">220</scrolltime>
            <itemlayout width="560" height="430">
                <control type="image">
                    <left>12</left><top>12</top><width>536</width><height>396</height>
                    <texture border="22" colordiffuse="FF14151C">abk_sq_round.png</texture>
                </control>
                <control type="image">
                    <left>12</left><top>12</top><width>536</width><height>258</height>
                    <aspectratio>scale</aspectratio>
                    <texture colordiffuse="CCFFFFFF">$INFO[ListItem.Art(thumb)]</texture>
                    <visible>!String.IsEqual(ListItem.Property(fit),keep)</visible>
                </control>
                <control type="image">
                    <left>40</left><top>30</top><width>480</width><height>222</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="CCFFFFFF">$INFO[ListItem.Art(thumb)]</texture>
                    <visible>String.IsEqual(ListItem.Property(fit),keep)</visible>
                </control>
                <control type="label">
                    <left>24</left><top>276</top><width>512</width><height>124</height>
                    <font>abk_set_m</font><align>center</align><aligny>center</aligny>
                    <textcolor>B3FFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="image">
                    <left>484</left><top>318</top><width>40</width><height>40</height>
                    <texture colordiffuse="FF2FD07A">abk_fs_check.png</texture>
                    <visible>String.IsEqual(ListItem.Property(current),true)</visible>
                </control>
            </itemlayout>
            <focusedlayout width="560" height="430">
                <control type="group">
                    <animation effect="zoom" start="100" end="104" center="280,210" time="160" tween="cubic" easing="out" reversible="false">Focus</animation>
                    <control type="image">
                        <left>12</left><top>12</top><width>536</width><height>396</height>
                        <texture border="22" colordiffuse="FF20222C">abk_sq_round.png</texture>
                    </control>
                    <control type="image">
                        <left>12</left><top>12</top><width>536</width><height>258</height>
                        <aspectratio>scale</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                        <visible>!String.IsEqual(ListItem.Property(fit),keep)</visible>
                    </control>
                    <control type="image">
                        <left>40</left><top>30</top><width>480</width><height>222</height>
                        <aspectratio>keep</aspectratio>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                        <visible>String.IsEqual(ListItem.Property(fit),keep)</visible>
                    </control>
                    <control type="image">
                        <left>8</left><top>8</top><width>544</width><height>404</height>
                        <texture border="22" colordiffuse="F2FFFFFF">abk_sq_outline.png</texture>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="label">
                        <left>24</left><top>276</top><width>512</width><height>124</height>
                        <font>abk_set_m</font><align>center</align><aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>484</left><top>318</top><width>40</width><height>40</height>
                        <texture colordiffuse="FF2FD07A">abk_fs_check.png</texture>
                        <visible>String.IsEqual(ListItem.Property(current),true)</visible>
                    </control>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
