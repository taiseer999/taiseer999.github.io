<?xml version="1.0" encoding="UTF-8"?>
<!-- ABUKARIM TOOLS - Widgets Layout (ترتيب الودجات), 3.2.43~beta7.
     Same visual language as Skin Selection / Add-on Portal: dark glass, neon
     blue -> orange cards. Python contract: list 100 (Label, Label2, Art(icon),
     Property(current)), title 9001, subtitle 9003, hint 9002, footer 9004
     (description of the focused card). -->
<window type="dialog" id="13003">
    <defaultcontrol always="true">100</defaultcontrol>
    <zorder>1</zorder>
    <controls>

        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Window.Property(background)]</texture>
            <aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="EB030509">white.png</texture>
        </control>

        <!-- header -->
        <control type="label" id="9001">
            <left>0</left><top>70</top><width>1920</width><height>90</height>
            <font>AbkTitle</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF1E8FFF</shadowcolor>
            <label></label>
        </control>
        <control type="image">
            <left>810</left><top>168</top><width>150</width><height>4</height>
            <texture colordiffuse="FF1E8FFF">white.png</texture>
        </control>
        <control type="image">
            <left>960</left><top>168</top><width>150</width><height>4</height>
            <texture colordiffuse="FFFF7A1A">white.png</texture>
        </control>
        <control type="label" id="9003">
            <left>160</left><top>186</top><width>1600</width><height>50</height>
            <font>AbkCard</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFAFC3E6</textcolor>
            <label></label>
        </control>

        <!-- three option cards -->
        <control type="list" id="100">
            <left>210</left><top>262</top><width>1500</width><height>600</height>
            <orientation>horizontal</orientation>
            <onup>100</onup><ondown>100</ondown>
            <pagecontrol>-</pagecontrol>
            <scrolltime>200</scrolltime>

            <itemlayout width="500" height="600">
                <control type="image">
                    <left>20</left><top>20</top><width>460</width><height>560</height>
                    <texture colordiffuse="D90C1322">white.png</texture>
                </control>
                <control type="image">
                    <left>100</left><top>50</top><width>300</width><height>300</height>
                    <texture colordiffuse="A6FFFFFF">$INFO[ListItem.Art(icon)]</texture>
                    <aspectratio>keep</aspectratio>
                </control>
                <control type="label">
                    <left>40</left><top>370</top><width>420</width><height>70</height>
                    <font>AbkRowBold</font>
                    <align>center</align><aligny>center</aligny>
                    <textcolor>FF7F93B8</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>50</left><top>440</top><width>400</width><height>120</height>
                    <font>AbkCard</font>
                    <align>center</align><aligny>top</aligny>
                    <wrapmultiline>true</wrapmultiline>
                    <textcolor>FF5F7090</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="group">
                    <visible>String.IsEqual(ListItem.Property(current),true)</visible>
                    <control type="image">
                        <left>330</left><top>40</top><width>130</width><height>46</height>
                        <texture colordiffuse="99FF7A1A">white.png</texture>
                    </control>
                    <control type="label">
                        <left>330</left><top>40</top><width>130</width><height>46</height>
                        <font>AbkHint</font>
                        <align>center</align><aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Property(current_label)]</label>
                    </control>
                </control>
            </itemlayout>

            <focusedlayout width="500" height="600">
                <control type="group">
                    <animation effect="zoom" start="96" end="100" center="250,300" time="180" tween="cubic" easing="out">Focus</animation>
                    <control type="image">
                        <left>12</left><top>12</top><width>476</width><height>288</height>
                        <texture colordiffuse="FF1E8FFF">white.png</texture>
                    </control>
                    <control type="image">
                        <left>12</left><top>300</top><width>476</width><height>288</height>
                        <texture colordiffuse="FFFF7A1A">white.png</texture>
                    </control>
                    <control type="image">
                        <left>17</left><top>17</top><width>466</width><height>566</height>
                        <texture colordiffuse="FF0A0F1A">white.png</texture>
                    </control>
                    <control type="image">
                        <left>17</left><top>17</top><width>466</width><height>566</height>
                        <texture colordiffuse="1A1E8FFF">white.png</texture>
                    </control>
                    <control type="image">
                        <left>90</left><top>40</top><width>320</width><height>320</height>
                        <texture>$INFO[ListItem.Art(icon)]</texture>
                        <aspectratio>keep</aspectratio>
                    </control>
                    <control type="label">
                        <left>40</left><top>370</top><width>420</width><height>70</height>
                        <font>AbkRowBold</font>
                        <align>center</align><aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>50</left><top>440</top><width>400</width><height>120</height>
                        <font>AbkCard</font>
                        <align>center</align><aligny>top</aligny>
                        <wrapmultiline>true</wrapmultiline>
                        <textcolor>FFDCE6F5</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                    <control type="group">
                        <visible>String.IsEqual(ListItem.Property(current),true)</visible>
                        <control type="image">
                            <left>330</left><top>36</top><width>130</width><height>46</height>
                            <texture colordiffuse="FFFF7A1A">white.png</texture>
                        </control>
                        <control type="label">
                            <left>330</left><top>36</top><width>130</width><height>46</height>
                            <font>AbkHint</font>
                            <align>center</align><aligny>center</aligny>
                            <textcolor>FFFFFFFF</textcolor>
                            <label>$INFO[ListItem.Property(current_label)]</label>
                        </control>
                    </control>
                    <control type="image">
                        <left>190</left><top>566</top><width>120</width><height>6</height>
                        <texture colordiffuse="FFFF7A1A">white.png</texture>
                    </control>
                </control>
            </focusedlayout>
        </control>

        <!-- footer: focused card's note, then the key hint -->
        <control type="label" id="9004">
            <left>160</left><top>890</top><width>1600</width><height>50</height>
            <font>AbkCard</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFB27A</textcolor>
            <label>$INFO[Container(100).ListItem.Property(note)]</label>
        </control>
        <control type="label" id="9002">
            <left>0</left><top>975</top><width>1920</width><height>40</height>
            <font>AbkHint</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFAFC3E6</textcolor>
            <label></label>
        </control>

    </controls>
</window>
