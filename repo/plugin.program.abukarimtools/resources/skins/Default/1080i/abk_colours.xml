<?xml version="1.0" encoding="UTF-8"?>
<!-- AB Tools 4.8.48 - AF3 Lucent Look "Colours" window (af3_lucent_colours.py).
     100 colour schemes, 200 highlight colours, 300 more colours, 400 turn off,
     900 close. Textures: media/abk_col/ (tools/gen_af3_colours.py).
     Fonts abk_set_* are registered in the active skin by the patch sweep. -->
<window type="dialog">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>
    <defaultcontrol always="true">100</defaultcontrol>
    <controls>
        <control type="image">
            <texture>white.png</texture>
            <colordiffuse>B3000000</colordiffuse>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" end="0" time="150">WindowClose</animation>
        </control>
        <control type="group">
            <left>110</left>
            <top>60</top>
            <width>1700</width>
            <height>960</height>
            <animation effect="fade" start="0" end="100" time="220">WindowOpen</animation>
            <animation effect="zoom" start="96" end="100" center="960,540" time="240" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" end="0" time="150">WindowClose</animation>
            <!-- frame -->
            <control type="image">
                <texture border="40">abk_col/panel.png</texture>
                <colordiffuse>FC040408</colordiffuse>
            </control>
            <control type="image">
                <texture border="40">abk_col/panel_edge.png</texture>
                <colordiffuse>1FFFFFFF</colordiffuse>
            </control>
            <!-- title -->
            <control type="label">
                <left>80</left>
                <top>46</top>
                <width>1300</width>
                <height>80</height>
                <font>abk_set_xl</font>
                <textcolor>FFEDEDEF</textcolor>
                <label>$INFO[Window.Property(abk.col.title)]</label>
            </control>
            <!-- close -->
            <control type="button" id="900">
                <left>1566</left>
                <top>56</top>
                <width>60</width>
                <height>60</height>
                <texturefocus colordiffuse="FFF5A524">abk_col/close.png</texturefocus>
                <texturenofocus colordiffuse="B3FFFFFF">abk_col/close.png</texturenofocus>
                <label></label>
                <onleft>100</onleft>
                <ondown>100</ondown>
            </control>
            <!-- section header + hairline -->
            <control type="grouplist">
                <left>80</left>
                <top>140</top>
                <width>1540</width>
                <height>40</height>
                <orientation>horizontal</orientation>
                <itemgap>28</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
                <control type="label">
                    <width>auto</width>
                    <height>40</height>
                    <font>abk_set_s</font>
                    <textcolor>8CFFFFFF</textcolor>
                    <label>$INFO[Window.Property(abk.col.header)]</label>
                </control>
                <control type="image">
                    <top>19</top>
                    <width>1540</width>
                    <height>2</height>
                    <texture>white.png</texture>
                    <colordiffuse>14FFFFFF</colordiffuse>
                </control>
            </control>
            <!-- colour schemes -->
            <control type="panel" id="100">
                <left>80</left>
                <top>206</top>
                <width>1564</width>
                <height>520</height>
                <orientation>vertical</orientation>
                <scrolltime>200</scrolltime>
                <onup>900</onup>
                <ondown>200</ondown>
                <itemlayout width="391" height="260">
                    <control type="image">
                        <width>367</width>
                        <height>236</height>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>188</top>
                        <width>347</width>
                        <height>48</height>
                        <font>abk_set_m</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>D9FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>297</left>
                        <top>14</top>
                        <width>56</width>
                        <height>56</height>
                        <texture>abk_col/badge.png</texture>
                        <visible>String.IsEqual(ListItem.Property(selected),true)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="391" height="260">
                    <control type="image">
                        <width>367</width>
                        <height>236</height>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="image">
                        <width>367</width>
                        <height>236</height>
                        <texture>abk_col/card_focus.png</texture>
                        <colordiffuse>FFF5A524</colordiffuse>
                        <visible>Control.HasFocus(100)</visible>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>188</top>
                        <width>347</width>
                        <height>48</height>
                        <font>abk_set_m</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>297</left>
                        <top>14</top>
                        <width>56</width>
                        <height>56</height>
                        <texture>abk_col/badge.png</texture>
                        <visible>String.IsEqual(ListItem.Property(selected),true)</visible>
                    </control>
                </focusedlayout>
            </control>
            <!-- highlight colours -->
            <control type="list" id="200">
                <left>80</left>
                <top>750</top>
                <width>780</width>
                <height>130</height>
                <orientation>horizontal</orientation>
                <scrolltime>0</scrolltime>
                <onup>100</onup>
                <onright>300</onright>
                <itemlayout width="130" height="130">
                    <control type="image">
                        <left>15</left>
                        <top>15</top>
                        <width>100</width>
                        <height>100</height>
                        <texture>abk_col/circle.png</texture>
                        <colordiffuse>$INFO[ListItem.Property(colour)]</colordiffuse>
                    </control>
                    <control type="group">
                        <visible>String.IsEqual(ListItem.Property(selected),true)</visible>
                        <control type="image">
                            <left>37</left>
                            <top>37</top>
                            <width>56</width>
                            <height>56</height>
                            <texture>abk_col/circle.png</texture>
                            <colordiffuse>D9180810</colordiffuse>
                        </control>
                        <control type="image">
                            <left>43</left>
                            <top>43</top>
                            <width>44</width>
                            <height>44</height>
                            <texture>abk_col/check.png</texture>
                        </control>
                    </control>
                </itemlayout>
                <focusedlayout width="130" height="130">
                    <control type="image">
                        <left>1</left>
                        <top>1</top>
                        <width>128</width>
                        <height>128</height>
                        <texture>abk_col/ring.png</texture>
                        <colordiffuse>FFF5A524</colordiffuse>
                        <visible>Control.HasFocus(200)</visible>
                    </control>
                    <control type="image">
                        <left>15</left>
                        <top>15</top>
                        <width>100</width>
                        <height>100</height>
                        <texture>abk_col/circle.png</texture>
                        <colordiffuse>$INFO[ListItem.Property(colour)]</colordiffuse>
                    </control>
                    <control type="group">
                        <visible>String.IsEqual(ListItem.Property(selected),true)</visible>
                        <control type="image">
                            <left>37</left>
                            <top>37</top>
                            <width>56</width>
                            <height>56</height>
                            <texture>abk_col/circle.png</texture>
                            <colordiffuse>D9180810</colordiffuse>
                        </control>
                        <control type="image">
                            <left>43</left>
                            <top>43</top>
                            <width>44</width>
                            <height>44</height>
                            <texture>abk_col/check.png</texture>
                        </control>
                    </control>
                </focusedlayout>
            </control>
            <!-- more colours (palette) -->
            <control type="group">
                <left>875</left>
                <top>765</top>
                <control type="image">
                    <left>-14</left>
                    <top>-14</top>
                    <width>128</width>
                    <height>128</height>
                    <texture>abk_col/ring.png</texture>
                    <colordiffuse>FFF5A524</colordiffuse>
                    <visible>Control.HasFocus(300)</visible>
                </control>
                <control type="image">
                    <width>100</width>
                    <height>100</height>
                    <texture>abk_col/circle.png</texture>
                    <colordiffuse>FF1D1D20</colordiffuse>
                </control>
                <control type="group">
                    <visible>String.IsEqual(Window.Property(abk.col.custom),true)</visible>
                    <control type="image">
                        <left>8</left>
                        <top>8</top>
                        <width>84</width>
                        <height>84</height>
                        <texture>abk_col/circle.png</texture>
                        <colordiffuse>$INFO[Window.Property(abk.col.customcolour)]</colordiffuse>
                    </control>
                </control>
                <control type="image">
                    <left>24</left>
                    <top>24</top>
                    <width>52</width>
                    <height>52</height>
                    <texture>abk_col/palette.png</texture>
                    <colordiffuse>BFFFFFFF</colordiffuse>
                    <visible>!String.IsEqual(Window.Property(abk.col.custom),true)</visible>
                </control>
                <control type="image">
                    <left>28</left>
                    <top>28</top>
                    <width>44</width>
                    <height>44</height>
                    <texture>abk_col/check.png</texture>
                    <visible>String.IsEqual(Window.Property(abk.col.custom),true)</visible>
                </control>
                <control type="button" id="300">
                    <width>100</width>
                    <height>100</height>
                    <texturefocus></texturefocus>
                    <texturenofocus></texturenofocus>
                    <label></label>
                    <onleft>200</onleft>
                    <onright>400</onright>
                    <onup>100</onup>
                </control>
            </control>
            <!-- turn off -->
            <control type="group">
                <left>1166</left>
                <top>765</top>
                <visible>String.IsEqual(Window.Property(abk.col.on),true)</visible>
                <control type="image">
                    <width>460</width>
                    <height>100</height>
                    <texture border="50,0,50,0">abk_col/pill.png</texture>
                    <colordiffuse>FF0E0E13</colordiffuse>
                </control>
                <control type="image">
                    <width>460</width>
                    <height>100</height>
                    <texture border="50,0,50,0">abk_col/pill_edge.png</texture>
                    <colordiffuse>FFF5A524</colordiffuse>
                    <visible>Control.HasFocus(400)</visible>
                </control>
                <control type="button" id="400">
                    <width>460</width>
                    <height>100</height>
                    <texturefocus></texturefocus>
                    <texturenofocus></texturenofocus>
                    <font>abk_set_l</font>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>B3FFFFFF</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <label>$INFO[Window.Property(abk.col.off)]</label>
                    <onleft>300</onleft>
                    <onup>100</onup>
                </control>
            </control>
            <!-- hint -->
            <control type="image">
                <left>80</left>
                <top>890</top>
                <width>1540</width>
                <height>2</height>
                <texture>white.png</texture>
                <colordiffuse>14FFFFFF</colordiffuse>
            </control>
            <control type="label">
                <left>80</left>
                <top>900</top>
                <width>1540</width>
                <height>44</height>
                <font>abk_set_s</font>
                <aligny>center</aligny>
                <textcolor>80FFFFFF</textcolor>
                <label>$INFO[Window.Property(abk.col.hint)]</label>
            </control>
        </control>
    </controls>
</window>
