<?xml version="1.0" encoding="UTF-8"?>
<!-- 3.4.22: Installation Wizard background - blurred backdrop + "setup in
     progress, do not restart" warning in English and Arabic. Shown modeless
     (setup_overlay.py) BEHIND every setup dialog (zorder 0), kept alive across
     skin reloads. No focusable control: it never takes over the remote.
     Python contract: Window.Property(title_en|title_ar|body_en|body_ar|step|done). -->
<window type="dialog">
    <zorder>0</zorder>
    <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <!-- blurred backdrop -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>abk_setup_blur.jpg</texture>
            <aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="66000000">white.png</texture>
        </control>

        <!-- card -->
        <control type="image">
            <left>260</left><top>200</top><width>1400</width><height>720</height>
            <texture colordiffuse="E60D1116">white.png</texture>
        </control>
        <control type="image">
            <left>260</left><top>200</top><width>1400</width><height>8</height>
            <texture colordiffuse="FFFFC107">white.png</texture>
        </control>

        <control type="image">
            <left>890</left><top>240</top><width>140</width><height>140</height>
            <texture>abk_setup_warning.png</texture>
            <aspectratio>keep</aspectratio>
            <animation effect="fade" start="100" end="55" time="900" tween="sine" pulse="true" condition="String.IsEmpty(Window.Property(done))">Conditional</animation>
        </control>

        <control type="label">
            <left>300</left><top>395</top><width>1320</width><height>75</height>
            <font>AbkTitle</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title_en)]</label>
        </control>
        <control type="label">
            <left>300</left><top>470</top><width>1320</width><height>75</height>
            <font>AbkTitle</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(title_ar)]</label>
        </control>

        <control type="image">
            <left>860</left><top>560</top><width>200</width><height>4</height>
            <texture colordiffuse="FFFFC107">white.png</texture>
        </control>

        <control type="textbox">
            <left>330</left><top>585</top><width>1260</width><height>110</height>
            <font>AbkRow</font>
            <align>center</align>
            <textcolor>FFE8EEF3</textcolor>
            <label>$INFO[Window.Property(body_en)]</label>
        </control>
        <control type="textbox">
            <left>330</left><top>700</top><width>1260</width><height>110</height>
            <font>AbkRow</font>
            <align>center</align>
            <textcolor>FFE8EEF3</textcolor>
            <label>$INFO[Window.Property(body_ar)]</label>
        </control>

        <!-- current step (EN • AR) + spinner -->
        <control type="image">
            <left>300</left><top>842</top><width>48</width><height>48</height>
            <texture>abk_setup_spinner.png</texture>
            <aspectratio>keep</aspectratio>
            <visible>String.IsEmpty(Window.Property(done))</visible>
            <animation effect="rotate" start="0" end="-360" center="auto" time="1100" loop="true" condition="true">Conditional</animation>
        </control>
        <control type="label">
            <left>360</left><top>830</top><width>1200</width><height>72</height>
            <font>AbkCard</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFC107</textcolor>
            <label>$INFO[Window.Property(step)]</label>
        </control>
    </controls>
</window>
