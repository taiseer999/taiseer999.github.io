<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">102</defaultcontrol>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<controls>
		<!-- Overlay dim background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="E60A0C10">common/white.png</texture>
		</control>

		<!-- Main Dialog Background -->
		<control type="image">
			<left>360</left>
			<top>270</top>
			<width>1200</width>
			<height>540</height>
			<texture colordiffuse="FF161B22">common/white.png</texture>
		</control>

		<!-- Header Background -->
		<control type="image">
			<left>360</left>
			<top>270</top>
			<width>1200</width>
			<height>60</height>
			<texture colordiffuse="FF185F9D">common/white.png</texture>
		</control>

		<!-- Header Title -->
		<control type="label">
			<left>390</left>
			<top>270</top>
			<width>1140</width>
			<height>60</height>
			<font>font14</font>
			<textcolor>FFFFFFFF</textcolor>
			<align>right</align>
			<aligny>center</aligny>
			<label>AM Lite - MDBList API Key</label>
		</control>

		<control type="label">
			<left>420</left>
			<top>365</top>
			<width>1080</width>
			<height>50</height>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<aligny>center</aligny>
			<label>Choose how you would like to enter your MDBList API key:</label>
		</control>

		<control type="list" id="100">
			<left>420</left>
			<top>430</top>
			<width>1080</width>
			<height>140</height>
			<onleft>100</onleft>
			<onright>102</onright>
			<onup>100</onup>
			<ondown>100</ondown>
			<scrolltime>200</scrolltime>
			<itemlayout height="60" width="1040">
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>1000</width>
					<height>60</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="1040">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1040</width>
					<height>60</height>
					<texture colordiffuse="FF38BDF8">common/white.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>1000</width>
					<height>60</height>
					<font>font13</font>
					<textcolor>FF0F172A</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>

		<control type="button" id="102">
			<left>1270</left>
			<top>690</top>
			<width>220</width>
			<height>60</height>
			<label>Cancel</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FF0F172A</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<texturefocus colordiffuse="FF38BDF8">common/white.png</texturefocus>
			<texturenofocus colordiffuse="FF21262D">common/white.png</texturenofocus>
			<onleft>100</onleft>
			<onright>100</onright>
			<onup>100</onup>
			<ondown>100</ondown>
		</control>
	</controls>
</window>
