<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">100</defaultcontrol>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<controls>
		<!-- Overlay dim background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="E60A0C10">common/white.png</texture>
		</control>

		<!-- Main Dialog Background -->
		<control type="image">
			<left>360</left>
			<top>120</top>
			<width>1200</width>
			<height>840</height>
			<texture colordiffuse="FF161B22">common/white.png</texture>
		</control>

		<!-- Header Background -->
		<control type="image">
			<left>360</left>
			<top>120</top>
			<width>1200</width>
			<height>60</height>
			<texture colordiffuse="FF185F9D">common/white.png</texture>
		</control>

		<!-- Header Title -->
		<control type="label" id="103">
			<left>390</left>
			<top>120</top>
			<width>1140</width>
			<height>60</height>
			<font>font14</font>
			<textcolor>FFFFFFFF</textcolor>
			<align>right</align>
			<aligny>center</aligny>
			<label>AM Lite - Choose TMDb Helper Players</label>
		</control>

		<control type="list" id="100">
			<left>420</left>
			<top>205</top>
			<width>1080</width>
			<height>615</height>
			<onleft>100</onleft>
			<onright>101</onright>
			<onup>100</onup>
			<ondown>100</ondown>
			<pagecontrol>110</pagecontrol>
			<scrolltime>200</scrolltime>
			<itemlayout height="60" width="1040">
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>1000</width>
					<height>60</height>
					<font>font13</font>
					<textcolor>FF38BDF8</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>String.IsEqual(ListItem.Property(selected),true)</visible>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>1000</width>
					<height>60</height>
					<font>font13</font>
					<textcolor>FFFFFFFF</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
					<visible>!String.IsEqual(ListItem.Property(selected),true)</visible>
				</control>
			</itemlayout>
			<focusedlayout height="60" width="1040">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1040</width>
					<height>60</height>
					<texture colordiffuse="FF38BDF8">common/white.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>1000</width>
					<height>60</height>
					<font>font13</font>
					<textcolor>FF0F172A</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>

		<control type="scrollbar" id="110">
			<left>1510</left>
			<top>205</top>
			<width>20</width>
			<height>615</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
		</control>

		<control type="button" id="101">
			<left>1030</left>
			<top>855</top>
			<width>220</width>
			<height>60</height>
			<label>Install</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FF0F172A</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<texturefocus colordiffuse="FF38BDF8">common/white.png</texturefocus>
			<texturenofocus colordiffuse="FF21262D">common/white.png</texturenofocus>
			<onleft>100</onleft>
			<onright>102</onright>
			<onup>100</onup>
			<ondown>100</ondown>
		</control>

		<control type="button" id="102">
			<left>1270</left>
			<top>855</top>
			<width>220</width>
			<height>60</height>
			<label>$INFO[Window.Property(am.l.0)]</label>
			<font>font13</font>
			<textcolor>FFFFFFFF</textcolor>
			<focusedcolor>FF0F172A</focusedcolor>
			<align>center</align>
			<aligny>center</aligny>
			<texturefocus colordiffuse="FF38BDF8">common/white.png</texturefocus>
			<texturenofocus colordiffuse="FF21262D">common/white.png</texturenofocus>
			<onleft>101</onleft>
			<onright>100</onright>
			<onup>100</onup>
			<ondown>100</ondown>
		</control>
	</controls>
</window>
