<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">200</defaultcontrol>
    <controls>

        <!-- Overlay dim background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E60A0C10">common/white.png</texture>
        </control>

        <!-- Main Modal Container (1200x680) -->
        <control type="group">
            <left>360</left>
            <top>200</top>

            <!-- Card Background (Dark Body) -->
            <control type="image">
                <left>0</left>
                <top>60</top>
                <width>1200</width>
                <height>620</height>
                <texture colordiffuse="FF161B22">common/white.png</texture>
            </control>

            <!-- Header Background (Blue Bar) -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>60</height>
                <texture colordiffuse="FF185F9D">common/white.png</texture>
            </control>

            <!-- Provider Logo (ID 106) - Left Side of Header -->
            <control type="image" id="106">
                <left>20</left>
                <top>10</top>
                <width>250</width>
                <height>40</height>
                <aspectratio align="left">keep</aspectratio>
                <texture></texture>
            </control>

            <!-- Header Title (ID 100) - Right Side of Header -->
            <control type="label" id="100">
                <left>290</left>
                <top>0</top>
                <width>890</width>
                <height>60</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>right</align>
                <aligny>center</aligny>
                <label></label>
            </control>

            <!-- QR Code Section (ID 110) -->
            <control type="group" id="110">
                <left>60</left>
                <top>120</top>

                <!-- White QR Card Background -->
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>420</width>
                    <height>420</height>
                    <texture colordiffuse="FFFFFFFF">common/white.png</texture>
                </control>

                <!-- QR Image (ID 101) -->
                <control type="image" id="101">
                    <left>20</left>
                    <top>20</top>
                    <width>380</width>
                    <height>380</height>
                    <aspectratio>keep</aspectratio>
                    <texture></texture>
                </control>
            </control>

            <!-- Instructions & Information Column -->
            <control type="group">
                <left>530</left>
                <top>120</top>

                <!-- Step 1 Text -->
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>610</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>99FFFFFF</textcolor>
                    <label>Scan QR code or visit this URL:</label>
                </control>

                <!-- URL Highlight Box & Verification URL (ID 102) -->
                <control type="image">
                    <left>0</left>
                    <top>35</top>
                    <width>610</width>
                    <height>50</height>
                    <texture colordiffuse="1F38BDF8">common/white.png</texture>
                </control>
                <control type="label" id="102">
                    <left>20</left>
                    <top>35</top>
                    <width>570</width>
                    <height>50</height>
                    <font>font14</font>
                    <textcolor>FF38BDF8</textcolor>
                    <aligny>center</aligny>
                    <label></label>
                </control>

                <!-- Step 2 Text -->
                <control type="label">
                    <left>0</left>
                    <top>110</top>
                    <width>610</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>99FFFFFF</textcolor>
                    <label>Enter the authorization code:</label>
                </control>

                <!-- User Code Card Background & Code Display (ID 103) -->
                <control type="image">
                    <left>0</left>
                    <top>145</top>
                    <width>610</width>
                    <height>90</height>
                    <texture colordiffuse="FF21262D">common/white.png</texture>
                </control>
                <control type="label" id="103">
                    <left>0</left>
                    <top>145</top>
                    <width>610</width>
                    <height>90</height>
                    <font>font16</font>
                    <textcolor>FFFFD166</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label></label>
                </control>

                <!-- Progress Bar (ID 104) -->
                <control type="progress" id="104">
                    <left>0</left>
                    <top>265</top>
                    <width>610</width>
                    <height>8</height>
                    <texturebg colordiffuse="33FFFFFF">common/white.png</texturebg>
                    <midtexture colordiffuse="FF38BDF8">common/white.png</midtexture>
                </control>

                <!-- Timer / Expiration Info (ID 105) -->
                <control type="label" id="105">
                    <left>0</left>
                    <top>285</top>
                    <width>610</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>80FFFFFF</textcolor>
                    <align>left</align>
                    <label></label>
                </control>
            </control>

            <!-- Bottom Action Line / Cancel Button (ID 200) -->
            <control type="button" id="200">
                <left>910</left>
                <top>585</top>
                <width>230</width>
                <height>55</height>
                <label>Cancel</label>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF0F172A</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus colordiffuse="FF38BDF8">common/white.png</texturefocus>
                <texturenofocus colordiffuse="FF21262D">common/white.png</texturenofocus>
            </control>
        </control>

    </controls>
</window>