      <control type="image">
        <left>430</left><top>40</top><width>140</width><height>140</height>
        <texture>logo.png</texture>
      </control>

      <!-- lead line -->
      <control type="label" id="101">
        <left>60</left><top>196</top><width>880</width><height>46</height>
        <font>font30</font><align>center</align>
        <textcolor>FF30AAE2</textcolor>
        <label></label>
      </control>
      <!-- prayer name (big) -->
      <control type="label" id="102">
        <left>60</left><top>240</top><width>880</width><height>120</height>
        <font>font60</font><align>center</align>
        <textcolor>FFFFFFFF</textcolor>
